{
  // The site is static files. src/worker.js answers only /e, the page's count of what readers
  // do, into Workers Analytics Engine (dataset yisu_events); every other address is a file.
  "name": "yisu",
  "compatibility_date": "2025-10-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/e"]
  },
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "yisu_events" }],
  "routes": [{ "pattern": "yisu.aixie.de", "custom_domain": true }]
}
